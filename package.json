{
  "name": "class-tracker",
  "version": "4.5.29",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "verify": "tsx scripts/verify-patterns.ts",
    "prepare": "husky install",
    "create-update": "tsx scripts/create-app-update.ts",
    "backup": "tsx scripts/backup-to-mongodb.ts backup",
    "backup:list": "tsx scripts/backup-to-mongodb.ts list",
    "backup:restore": "tsx scripts/restore-from-mongodb.ts",
    "backup:schedule": "tsx scripts/backup-to-mongodb.ts schedule",
    "backup:cleanup": "tsx scripts/backup-to-mongodb.ts cleanup",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "pwsh -File scripts/run-e2e-tests.ps1",
    "test:e2e:raw": "playwright test",
    "test:e2e:staging": "cross-env NEXT_PUBLIC_CONVEX_URL_STAGING=https://greedy-partridge-29.convex.cloud playwright test",
    "test:e2e:ui": "pwsh -File scripts/run-e2e-tests.ps1 -UI",
    "test:e2e:headed": "pwsh -File scripts/run-e2e-tests.ps1 -Headed",
    "test:e2e:debug": "pwsh -File scripts/run-e2e-tests.ps1 -Debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:record": "cross-env HAR_MODE=record playwright test",
    "test:e2e:replay": "cross-env HAR_MODE=replay playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "convex": "^1.28.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.554.0",
    "mongodb": "^6.21.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-resizable-panels": "^3.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.19.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.10"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
