{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
    "default": true,
    "MD013": false,
    "MD033": {
        "allowed_elements": [
            "br",
            "details",
            "summary",
            "sup",
            "sub",
            "kbd"
        ]
    },
    "MD035": {
        "style": "---"
    },
    "MD041": false,
    "MD024": {
        "siblings_only": true
    },
    "MD046": {
        "style": "fenced"
    }
}
