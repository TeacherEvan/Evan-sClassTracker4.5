# EditorConfig for Evan's Class Tracker 4.5
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = off

# Markdown code blocks (preserve formatting)
[*.md]
trim_trailing_whitespace = false

# Package files
[{package.json,package-lock.json}]
indent_style = space
indent_size = 2

# Config files
[*.config.{ts,js,mjs}]
indent_style = space
indent_size = 2
