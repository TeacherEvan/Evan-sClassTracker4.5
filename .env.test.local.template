# Test Environment Configuration
# Copy this file to .env.test.local and fill in your values
# DO NOT commit .env.test.local to git!

# ========================================
# Convex Test Deployment
# ========================================
# Get this from: https://dashboard.convex.dev/
# Create a separate "test" deployment (not production!)
NEXT_PUBLIC_CONVEX_URL=https://your-test-deployment.convex.cloud
CONVEX_DEPLOYMENT=prod:your-test-deployment-name
CONVEX_DEPLOY_KEY=prod:your-test-deployment-name|your-deploy-key-here

