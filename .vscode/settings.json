{
    // Disable spell checking for Thai language strings
    "cSpell.enabled": true,
    "cSpell.language": "en,th",
    "cSpell.ignoreRegExpList": [
        // Ignore Thai Unicode characters (U+0E00 to U+0E7F)
        "[\\u0E00-\\u0E7F]+"
    ],
    "cSpell.words": [
        "kbps",
        "youtu",
        "ytdl",
        "checkmarks",
        "oneline",
        "Playfair",
        "committerdate"
    ]
}